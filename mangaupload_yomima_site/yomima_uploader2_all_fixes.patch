+        "url": url, "index": 0, "session_token": token})
+    # 巨大な応答をそのまま中継しない (502 で落とすか、フォールバックで 404)
+    assert r.status_code in (404, 413, 502), r.status_code
+    assert len(r.content) < 11 * 1024 * 1024
