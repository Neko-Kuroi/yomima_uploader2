+def _png(color, size=(60, 90)):
+    buf = io.BytesIO()
+    Image.new("RGB", size, color).save(buf, "PNG")
+    return buf.getvalue()
+
+
+def _pixel(path):
+    with Image.open(path) as im:
+        return im.convert("RGB").getpixel((0, 0))
